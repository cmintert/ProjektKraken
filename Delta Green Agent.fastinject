{
  "meta": {
    "name": "Delta Green Agent",
    "description": "An Entity sheet for a Delta Green Agent. Enter your own scores and add the skills and Bonds your Agent uses. Blank fields are unassigned.",
    "target_type": "entity",
    "version": "1.0"
  },
  "inject": {
    "tags": [],
    "type_value": null,
    "attributes": {
      "HP Current": "",
      "HP Maximum": "",
      "WP Current": "",
      "WP Maximum": "",
      "SAN Current": "",
      "Breaking Point": "",
      "Bond 1": "",
      "Bond 1 Score": "",
      "Bond 2": "",
      "Bond 2 Score": "",
      "Bond 3": "",
      "Bond 3 Score": "",
      "Strength (STR)": "",
      "Constitution (CON)": "",
      "Dexterity (DEX)": "",
      "Intelligence (INT)": "",
      "Power (POW)": "",
      "Charisma (CHA)": "",
      "Motivations": "",
      "Disorders": "",
      "Violence Adaptation Marks": 0,
      "Helplessness Adaptation Marks": 0,
      "Alias": "",
      "Profession": "",
      "Rank": "",
      "Employer": "",
      "Nationality": "",
      "Appearance": "",
      "Education and Career": "",
      "Alertness (%)": "",
      "Bureaucracy (%)": "",
      "Dodge (%)": "",
      "Drive (%)": "",
      "Firearms (%)": "",
      "First Aid (%)": "",
      "HUMINT (%)": "",
      "Occult (%)": "",
      "Persuade (%)": "",
      "Search (%)": "",
      "Stealth (%)": "",
      "Unarmed Combat (%)": "",
      "Unnatural (%)": 0,
      "Other Skills and Specialties": "",
      "Weapons": "",
      "Armor": "",
      "Other Gear": "",
      "_sheet_layout": [
        [{"type": "header", "text": "Condition"}],
        ["HP Current", "HP Maximum"],
        ["WP Current", "WP Maximum"],
        ["SAN Current", "Breaking Point"],
        [{"type": "header", "text": "Bonds"}],
        [{"key": "Bond 1", "weight": 2}, "Bond 1 Score"],
        [{"key": "Bond 2", "weight": 2}, "Bond 2 Score"],
        [{"key": "Bond 3", "weight": 2}, "Bond 3 Score"],
        [{"type": "header", "text": "Statistics"}],
        ["Strength (STR)", "Constitution (CON)"],
        ["Dexterity (DEX)", "Intelligence (INT)"],
        ["Power (POW)", "Charisma (CHA)"],
        [{"type": "header", "text": "Psychological Profile"}],
        ["Motivations"],
        ["Disorders"],
        ["Violence Adaptation Marks", "Helplessness Adaptation Marks"],
        [{"type": "header", "text": "Identity"}],
        ["Alias", "Nationality"],
        ["Profession", "Rank"],
        ["Employer"],
        ["Appearance"],
        ["Education and Career"],
        [{"type": "header", "text": "Skills"}],
        ["Alertness (%)", "Bureaucracy (%)"],
        ["Dodge (%)", "Drive (%)"],
        ["Firearms (%)", "First Aid (%)"],
        ["HUMINT (%)", "Occult (%)"],
        ["Persuade (%)", "Search (%)"],
        ["Stealth (%)", "Unarmed Combat (%)"],
        ["Unnatural (%)"],
        ["Other Skills and Specialties"],
        [{"type": "header", "text": "Equipment"}],
        ["Weapons"],
        ["Armor"],
        ["Other Gear"]
      ]
    }
  }
}
