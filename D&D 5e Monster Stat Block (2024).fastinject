{
  "meta": {
    "name": "D&D 5e Monster Stat Block (2024)",
    "description": "A blank monster stat block for the 2024 rules. Use the Entity name for the monster's name. Enter published or homebrew statistics as written, and leave optional fields blank when they do not apply.",
    "target_type": "entity",
    "version": "1.0"
  },
  "inject": {
    "tags": [],
    "type_value": null,
    "attributes": {
      "Size": "",
      "Creature Type": "",
      "Creature Tags": "",
      "Alignment": "",
      "Armor Class": "",
      "Speed": "",
      "Initiative Modifier": "",
      "Initiative Score": "",
      "Hit Points": "",
      "Hit Dice": "",
      "STR Score": "",
      "STR Mod": "",
      "STR Save": "",
      "DEX Score": "",
      "DEX Mod": "",
      "DEX Save": "",
      "CON Score": "",
      "CON Mod": "",
      "CON Save": "",
      "INT Score": "",
      "INT Mod": "",
      "INT Save": "",
      "WIS Score": "",
      "WIS Mod": "",
      "WIS Save": "",
      "CHA Score": "",
      "CHA Mod": "",
      "CHA Save": "",
      "Skills": "",
      "Resistances": "",
      "Vulnerabilities": "",
      "Immunities": "",
      "Gear": "",
      "Senses": "",
      "Passive Perception": "",
      "Languages": "",
      "Challenge Rating": "",
      "XP": "",
      "Proficiency Bonus": "",
      "Traits": "",
      "Actions": "",
      "Bonus Actions": "",
      "Reactions": "",
      "Legendary Action Uses": "",
      "Legendary Actions": "",
      "_sheet_layout": [
        [{"type": "header", "text": "Identity"}],
        ["Size", "Creature Type"],
        ["Creature Tags", "Alignment"],
        [{"type": "header", "text": "Combat Statistics"}],
        ["Armor Class", "Speed"],
        ["Initiative Modifier", "Initiative Score"],
        ["Hit Points", "Hit Dice"],
        [{"type": "header", "text": "Ability Scores and Saves"}],
        ["STR Score", "STR Mod", "STR Save"],
        ["DEX Score", "DEX Mod", "DEX Save"],
        ["CON Score", "CON Mod", "CON Save"],
        ["INT Score", "INT Mod", "INT Save"],
        ["WIS Score", "WIS Mod", "WIS Save"],
        ["CHA Score", "CHA Mod", "CHA Save"],
        [{"type": "header", "text": "Skills, Defenses, and Gear"}],
        ["Skills"],
        ["Resistances", "Vulnerabilities"],
        ["Immunities"],
        ["Gear"],
        [{"type": "header", "text": "Senses and Languages"}],
        [{"key": "Senses", "weight": 2}, "Passive Perception"],
        ["Languages"],
        [{"type": "header", "text": "Challenge"}],
        ["Challenge Rating", "XP", "Proficiency Bonus"],
        [{"type": "header", "text": "Traits and Actions"}],
        ["Traits"],
        ["Actions"],
        ["Bonus Actions"],
        ["Reactions"],
        [{"type": "header", "text": "Legendary Actions"}],
        ["Legendary Action Uses"],
        ["Legendary Actions"]
      ]
    }
  }
}
